         try { await db.remove('transaksi', id); } catch (err) { return alert('Gagal menghapus: ' + err.message); }
         web.navigate('transaksi');
     },
+
+    /** Pesanan dari etalase online (pages/toko.js) masuk sebagai `transaksi`
+     *  berstatus 'draft' TANPA stok terpotong (lihat handlePublic() di
+     *  worker.js) — baru di sini, setelah staf toko menekan tombol ini,
+     *  stok dipotong & jurnal diposting lewat /api yang sudah tervalidasi
+     *  tenant (bukan endpoint publik), sama seperti alur simpan() instan
+     *  di shared.js. */
+    async konfirmasiPesanan(id) {
+        if (!confirm('Konfirmasi pesanan ini? Stok akan dipotong sesuai baris pesanan.')) return;
+        try {
+            const trx = await db.find('transaksi', t => t.id === id);
+            if (!trx || trx.status !== 'draft') return alert('Pesanan ini sudah diproses atau tidak valid.');
+            const [baris, produkList] = await Promise.all([
+                db.query('transaksi_produk', b => b.transaksiId === id),
+                db.query('produk', () => true),
+            ]);
+            for (const b of baris) {
+                const existing = await db.find('lokasi_produk', s => s.lokasiId === trx.lokasiId && s.produkId === b.produkId);
+                const stokLama = existing?.stok || 0;
+                const stokBaru = stokLama - b.qty;
+                if (existing) await db.update('lokasi_produk', existing.id, { stok: stokBaru });
+                else await db.insert('lokasi_produk', { lokasiId: trx.lokasiId, produkId: b.produkId, stok: stokBaru, stokMinimum: 0 });
+            }
+            await db.update('transaksi', id, { status: 'selesai' });
+            const cart = baris.map(b => ({ produkId: b.produkId, qty: b.qty, harga: b.hargaSatuan }));
+            await jurnalPage.postingTransaksi(trx, cart, { produkList });
+        } catch (err) { return alert('Gagal mengonfirmasi: ' + err.message); }
+        web.navigate(`transaksi/detail-${id}`);
+    },
+
+    async tolakPesanan(id) {
+        if (!confirm('Tolak pesanan ini? Pesanan akan ditandai batal (stok tidak berubah).')) return;
+        try { await db.update('transaksi', id, { status: 'batal' }); } catch (err) { return alert('Gagal menolak: ' + err.message); }
+        web.navigate(`transaksi/detail-${id}`);
+    },
 };
 
+/** `catatan` diisi JSON {sumber:'toko-online', pembeli:{...}} HANYA untuk
+ *  pesanan yang masuk dari etalase publik (lihat handlePublic() di
+ *  worker.js) — transaksi biasa dari kasir/transaksi internal punya
+ *  `catatan` kosong/teks bebas, jadi JSON.parse cukup dibungkus try/catch. */
+function bacaPesananOnline(trx) {
+    if (!trx?.catatan) return null;
+    try {
+        const meta = JSON.parse(trx.catatan);
+        return meta?.sumber === 'toko-online' ? meta.pembeli || {} : null;
+    } catch (e) { return null; }
+}
